{
  "name": "@traslado/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx src/server.ts",
    "db:bootstrap": "tsx src/bootstrap.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@traslado/shared": "workspace:*",
    "@hono/node-server": "2.0.12",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.0"
  }
}
