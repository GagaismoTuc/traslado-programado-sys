# Copy outside the repository into separate production/.env and staging/.env files.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-unique-secret
POSTGRES_DB=traslado
DATABASE_URL=postgresql://traslado_app:replace-with-a-unique-secret@db:5432/traslado
MIGRATION_DATABASE_URL=postgresql://traslado_migrator:replace-with-a-unique-secret@db:5432/traslado
BOOTSTRAP_DATABASE_URL=postgresql://postgres:replace-with-a-unique-secret@db:5432/traslado
MIGRATION_PASSWORD=replace-with-a-unique-secret
APPLICATION_PASSWORD=replace-with-a-unique-secret
SERVER_EPOCH=replace-with-a-unique-value
AUTH_ALLOWED_ORIGINS=https://production.example.invalid,https://driver.production.example.invalid
DEPLOY_PROJECT=production
CADDY_TLS=
PRODUCTION_HOST=production.example.invalid
STAGING_HOST=staging.example.invalid
# Docker networks: this project's private network and its ingress network in edge.compose.yaml.
# Production uses 172.16.11.0/24 and 172.16.10.0/24; staging uses 172.16.21.0/24 and 172.16.20.0/24.
DEPLOY_SUBNET=172.16.11.0/24
INGRESS_SUBNET=172.16.10.0/24
# Proxies in front of the API: the gateway (DEPLOY_SUBNET) and the edge (INGRESS_SUBNET). Never 0.0.0.0/0 or a public range.
TRUSTED_PROXY_CIDRS=172.16.11.0/24,172.16.10.0/24
