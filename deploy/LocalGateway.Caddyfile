{
    servers {
        trusted_proxies static {$INGRESS_SUBNET}
    }
}

:80 {
    @driver host {$LOCAL_DRIVER_HOST}
    handle_path /api/* {
        reverse_proxy api:3000
    }
    handle @driver {
        reverse_proxy driver:80
    }
    handle {
        # The throwaway offline prototype of issue #40 lives on the office host, where no service worker claims "/".
        redir /offline-prototype /offline-prototype/ 308
        handle_path /offline-prototype/* {
            reverse_proxy offline-prototype:8080
        }
        handle {
            reverse_proxy office:80
        }
    }
}
