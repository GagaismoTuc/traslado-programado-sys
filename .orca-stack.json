{
  "version": 1,
  "modo": "multiagente",
  "ramaBase": "main",
  "agentes": {
    "usa": [
      "claude",
      "agy",
      "codex",
      "pi"
    ],
    "preguntarAntes": [
      "claude"
    ],
    "preferencia": [
      "codex",
      "agy",
      "claude"
    ]
  },
  "verificacion": {
    "suite": "pnpm build && pnpm test",
    "typecheck": "pnpm typecheck"
  },
  "riesgo": [
    "**/migrations/**",
    "**/auth/**",
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "package.json",
    ".github/workflows/**",
    "**/*.env*",
    "**/deploy/**",
    "infra/**",
    "packages/api/drizzle/**",
    "packages/api/db/**",
    "packages/api/src/migrate.ts",
    "packages/api/src/bootstrap.ts"
  ],
  "merge": true,
  "despliegue": {
    "despues": false
  },
  "idioma": {
    "codigo": "inglés",
    "commits": "español",
    "prs": "español"
  },
  "setup": "completo",
  "lint": {
    "enabled": true,
    "excluir": [
      "packages/api/drizzle/meta/**",
      "pnpm-lock.yaml"
    ],
    "lenguajes": {
      "python": "warning"
    },
    "comentarios": {
      "alcance": "repo"
    }
  }
}
