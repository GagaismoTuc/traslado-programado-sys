#!/bin/sh
# Early warning only: CI is the check that counts (a hook is skipped with --no-verify).
# Conventional Commits header: type(scope)!: description (the description may be in Spanish).
header=$(head -n 1 "$1")
case "$header" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$header" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "commit-msg: the header does not follow Conventional Commits: \"$header\"" >&2
  echo "commit-msg: expected e.g. \"feat(traslados): agrega alta de traslado\"" >&2
  exit 1
fi
